    "/api/config/reload": {
      "post": {
        "summary": "Reload Config",
        "description": "Re-read the encrypted credential store from disk and rebuild providers\nfrom it, without changing any key. `GET /api/config` already always\nreflects the file's current contents, but the live providers used for\nlisting/resolving/deleting only pick up a change on reload. Use this\nafter updating the store out-of-band -- e.g. `debrid-hub config set`\nrun via `docker compose exec`, or a pre-encrypted `secrets.enc` dropped\ninto the mounted data directory while the server is already running.",
        "operationId": "reload_config_api_config_reload_post",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/links": {
      "get": {
        "summary": "Links",
        "description": "`debug=true` forces a live refresh and includes, per provider, every\noutbound HTTP call made while listing (method, url, redacted params,\nstatus, response body) -- for diagnosing a provider API change.",
        "operationId": "links_api_links_get",
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
