# Copy to .env and fill in the services you use. Empty = provider disabled.

# Real-Debrid API token: https://real-debrid.com/apitoken
DEBRID_REALDEBRID_TOKEN=

# AllDebrid API key: https://alldebrid.com/apikeys/
DEBRID_ALLDEBRID_APIKEY=

# TorBox API key: https://torbox.app/settings (Developer / API)
DEBRID_TORBOX_APIKEY=

# Optional bearer token to protect the exposed API + UI (recommended if internet-facing).
DEBRID_HUB_API_KEY=

# Seconds to cache the aggregated listing before hitting providers again.
DEBRID_HUB_CACHE_TTL=60

# Set to 1 to inject demo data and try the app with no real keys.
DEBRID_HUB_MOCK=

# Where provider keys set via the UI/CLI/API are stored, encrypted at rest.
# In Docker, point this at a mounted volume so keys survive container recreation.
DEBRID_HUB_DATA_DIR=

# Master key for the encrypted credential store. Leave empty to auto-generate one
# (kept in DEBRID_HUB_DATA_DIR/secret.key). Set it to move the store between hosts.
# Any passphrase works; a Fernet key is used as-is.
DEBRID_HUB_SECRET_KEY=
